# Скопій у .env і заповни своїми значеннями
# Шляхи на хості (заміни на власні)
STIRLING_TESSDATA=/home/trip/stirling-pdf/tessdata
STIRLING_CONFIG=/home/trip/stirling-pdf/configs

# Порти
STIRLING_PORT=3010

# Мови OCR для stirling-pdf (встановлюються в образ при старті).
# Закоментовано — увімкни, якщо потрібен OCR іншими мовами без ручного
# додавання .traineddata у STIRLING_TESSDATA.
# TESSERACT_LANGS=eng,ukr
# LANGS=en_GB,uk_UA

# Імена контейнерів
STIRLING_CONTAINER_NAME=stirling-pdf