# Скопій у .env і заповни своїми значеннями

# ========== Мережа ==========
# Локальна IP сервера — одна точка правки (extra_hosts, allowed hosts)
LAN_IP=192.168.1.110

# ========== Vaultwarden ==========
# Порт веб-інтерфейсу (прямий доступ — зазвичай ходимо через Caddy)
VAULTWARDEN_PORT=8192
# Дані (БД паролів) — створюється і бекапиться
VAULTWARDEN_DATA=/home/trip/vaultwarden
# Домен, з якого заходиш — потрібен мобільному додатку Bitwarden.
# Внутрішній сертифікат від Caddy (треба встановити його CA на пристрої)
VAULTWARDEN_DOMAIN=https://vault.home:8443
# Перший запуск: true → створи акаунт у UI → перемкни на false,
# інакше будь-хто в мережі зможе зареєструватися
SIGNUPS_ALLOWED=true
# Адмін-панель (опційно): згенеруй через `openssl rand -base64 48`
# ADMIN_TOKEN=
VAULTWARDEN_CONTAINER_NAME=vaultwarden

# ========== Uptime Kuma ==========
UPTIME_KUMA_PORT=3001
UPTIME_KUMA_DATA=/home/trip/uptime-kuma
UPTIME_KUMA_CONTAINER_NAME=uptime-kuma

# ========== Homepage (дашборд) ==========
# 3000 зайнятий Dockhand, тому 3002
HOMEPAGE_PORT=3002
# Host-заголовки, які дашборд приймає (через Caddy — з портом 8443!)
HOMEPAGE_ALLOWED_HOSTS=homepage.home:8443,${LAN_IP}:3002,127.0.0.1:3002
# Конфіг (settings.yaml, services.yaml, widgets.yaml) — копіюється з репо
HOMEPAGE_CONFIG=/home/trip/homepage
HOMEPAGE_CONTAINER_NAME=homepage
# Секрети для віджетів — заповнюються в Dockhand (Env), а не тут!
# Прокидуються в контейнер через compose (environment), тож після додавання
# у Dockhand — Save + Deploy
HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=
HOMEPAGE_VAR_PIHOLE_TOKEN=
HOMEPAGE_VAR_TAILSCALE_KEY=
HOMEPAGE_VAR_TAILSCALE_TAILNET=
# ID пристрою — з адмінки Tailscale: сторінка машини, URL виду .../admin/machines/<ID>
HOMEPAGE_VAR_TAILSCALE_DEVICEID=
HOMEPAGE_VAR_IMMICH_KEY=

# ========== SearXNG (метапошук) ==========
# Всередині контейнера завжди 8080; зовні 8081 (8080 зайнятий qBittorrent)
SEARXNG_PORT=8081
# Конфіг (settings.yml) — скопіюй з репо docker/admin/searxng/settings.yml
SEARXNG_CONFIG=/home/trip/searxng
# Публічна адреса через Caddy — слєш в кінці обов'язковий!
SEARXNG_BASE_URL=https://searxng.home:8443/
# Секрет — згенеруй через `openssl rand -hex 32`, впиши ТІЛЬКИ в Dockhand env!
SEARXNG_SECRET=
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_VALKEY_IMAGE=valkey/valkey:9-alpine
SEARXNG_CONTAINER_NAME=searxng
SEARXNG_VALKEY_CONTAINER_NAME=searxng-valkey

# ========== Caddy (HTTPS для Vaultwarden) ==========
# 443 зайнятий pihole, тому 8443
CADDY_PORT=8443
# Caddyfile — скопіюй файл з репо (docker/admin/Caddyfile)
CADDY_CONFIG=/home/trip/caddy/Caddyfile
# Тут живе внутрішній CA і сертифікати — не видаляй,
# інакше всі пристрої доведеться переналаштовувати
CADDY_DATA=/home/trip/caddy/data
CADDY_CONTAINER_NAME=caddy

# ========== Kopia ==========
KOPIA_PORT=51515
KOPIA_CONFIG=/home/trip/kopia/config
KOPIA_CACHE=/home/trip/kopia/cache
KOPIA_LOGS=/home/trip/kopia/logs
# rclone.conf, створений через `rclone config --config <цей файл>` (remote gdrive)
KOPIA_RCLONE_CONFIG=/home/trip/kopia/rclone.conf
# Пароль шифрування репозиторію Kopia — без нього бекапи не відновити!
KOPIA_PASSWORD=
# Логін/пароль веб-UI Kopia (http://host:51515) — змінити!
KOPIA_SERVER_USERNAME=kopia
KOPIA_SERVER_PASSWORD=changeme
KOPIA_CONTAINER_NAME=kopia
# Hostname контейнера записується в конфіг репозиторію — не міняй без потреби
KOPIA_HOSTNAME=kopia

# ========== Джерела для бекапу (read-only) ==========
# Тільки те, що бекапиться в Kopia (інші сервіси не монтуються)
VAULTWARDEN_DATA=/home/trip/vaultwarden
HOMEPAGE_CONFIG=/home/trip/homepage
PSNSELF_CONFIG=/home/trip/.config/psnself
SELFWISHES_DATA=/opt/selfwishes/data

# Часовий пояс
TZ=Europe/Kyiv
