# Скопій у .env і заповни своїми значеннями
# Шляхи на хості (заміни на власні)
IMMICH_UPLOAD=/home/trip/immich-app/upload
IMMICH_POSTGRES=/home/trip/immich-app/postgres

# Порт
IMMICH_PORT=2283

# Імена контейнерів
IMMICH_CONTAINER_NAME=immich_server
REDIS_CONTAINER_NAME=immich_redis
DB_CONTAINER_NAME=immich_postgres

# Версія immich (можна пінити, напр. v3 — але май на увазі майбутні міграції)
IMMICH_VERSION=release

# БД — один пароль на postgres user + immich DB_USERNAME
# Тільки символи A-Za-z0-9 (без спецсимволів/пробілів, радить офіційна дока)
DB_USERNAME=postgres
DB_NAME=immich
DB_PASSWORD=
